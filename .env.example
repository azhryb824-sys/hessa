DATABASE_URL=file:./prisma/dev.db
APP_URL=http://localhost:3000
# Only set false for local HTTP development.
SESSION_SECURE=false
# Set a private 12+ character bootstrap password before npm run setup.
HESSA_BOOTSTRAP_PASSWORD=
# Optional: enable open-ended model-backed teaching. No key is exposed to the browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# Optional NAT traversal for video across different networks; configure your own servers.
WEBRTC_STUN_URL=
WEBRTC_TURN_URL=
WEBRTC_TURN_USER=
WEBRTC_TURN_PASSWORD=
PAYMENT_INSTRUCTIONS=
# Use a persistent private directory in production.
RECORDINGS_DIR=

# Enforce paid access after a seven-day trial. Leave false while configuring plans.
BILLING_ENFORCED=false
